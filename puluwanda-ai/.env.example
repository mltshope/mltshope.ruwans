# Copy this file to .env and fill in the values.

# Claude API key - get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# Microsoft (Outlook) app registration - see README "Outlook setup"
MS_CLIENT_ID=
# "common" works for both personal (outlook.com/hotmail) and work/school accounts
MS_TENANT=common

# Language for the AI update: Sinhala, English, or Singlish
SUMMARY_LANGUAGE=Sinhala

# How far back to look (hours) when building an update
LOOKBACK_HOURS=24

PORT=3000
